{
  "manifest_version": 3,
  "name": "Rulecard",
  "version": "0.3.0",
  "description": "Learn the one rule behind each SAT Reading & Writing and Math miss: capture a Question Bank question, get the rule, practice it.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Rulecard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://satsuiteeducatorquestionbank.collegeboard.org/*",
    "https://satsuitequestionbank.collegeboard.org/*",
    "https://rulecard.vercel.app/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Capture the current tab into Rulecard"
    }
  },
  "homepage_url": "https://rulecard.vercel.app"
}
