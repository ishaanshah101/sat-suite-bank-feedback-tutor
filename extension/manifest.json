{
  "manifest_version": 3,
  "name": "Rulecard",
  "version": "0.7.0",
  "description": "Learn the rule behind each SAT Question Bank question: open your Question Bank PDF export and get the official explanation translated into 1 to 3 rules.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Rulecard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://rulecard.vercel.app/*"
  ],
  "homepage_url": "https://rulecard.vercel.app",
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
