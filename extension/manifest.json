{
  "manifest_version": 3,
  "name": "Rulecard",
  "version": "0.8.0",
  "description": "Capture an SAT question on screen (a Question Bank PDF or a practice test) and get the answer plus the 2 or 3 rules behind it.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rulecard: capture this question",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://rulecard.vercel.app/*",
    "https://mypractice.collegeboard.org/*"
  ],
  "homepage_url": "https://rulecard.vercel.app",
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Capture the question on this tab"
    }
  }
}
